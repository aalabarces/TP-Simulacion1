{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        ".validate": "newData.hasChildren(['host'])",
        "host": { ".validate": "newData.isString()" },
        "creada": { ".validate": "newData.isNumber()" },
        "guest": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "offer": { ".validate": "newData.isString() && newData.val().length < 12000" },
        "answer": {
          ".write": "auth != null && data.parent().child('guest').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length < 12000"
        },
        "$otro": { ".validate": false }
      }
    }
  }
}
